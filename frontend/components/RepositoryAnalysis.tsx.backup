                </div>

                <div className="h-3 overflow-hidden rounded-full bg-zinc-800">
                  <motion.div
                    initial={{
                      width: 0,
                    }}
                    whileInView={{
                      width: "82%",
                    }}
                    viewport={{
                      once: true,
                    }}
                    transition={{
                      duration: 1.8,
                    }}
                    className="h-full rounded-full bg-gradient-to-r from-orange-500 via-orange-400 to-amber-300"
